# Copy this file to .env for local development.
# Never commit a real key.

# Your personal Groq key. Required for every request.
# Create one free at https://console.groq.com/keys
# You can also store it with: promptpilot config set-key
GROQ_API_KEY=

# Model used when a command does not pass --model.
PROMPTPILOT_MODEL=llama-3.1-8b-instant

# HTTP timeout in seconds for every Groq request.
PROMPTPILOT_TIMEOUT_SECONDS=45
