# Copy this file to .env for local development.
# Never commit a real key.

# Your personal Groq key. Used for every request once the demo quota is spent.
GROQ_API_KEY=

# Optional shared key for a private demo build. Never commit a real value.
PROMPTPILOT_DEMO_API_KEY=

# Model used when a command does not pass --model.
PROMPTPILOT_MODEL=llama-3.1-8b-instant

# HTTP timeout in seconds for every Groq request.
PROMPTPILOT_TIMEOUT_SECONDS=45

# How many successful demo prompts are allowed before a personal key is required.
PROMPTPILOT_DEMO_LIMIT=10
