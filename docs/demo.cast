[19.087256, "o", "\u001b[1;39m{\u001b[0m\r\n  \u001b[1;34m\"requests\"\u001b[0m\u001b[1;39m:\u001b[0m \u001b[0;39m32\u001b[0m\u001b[1;39m,\u001b[0m\r\n  \u001b[1;34m\"successful\"\u001b[0m\u001b[1;39m:\u001b[0m \u001b[0;39m32\u001b[0m\u001b[1;39m,\u001b[0m\r\n  \u001b[1;34m\"failed\"\u001b[0m\u001b[1;39m:\u001b[0m \u001b[0;39m0\u001b[0m\u001b[1;39m,\u001b[0m\r\n  \u001b[1;34m\"average_latency_ms\"\u001b[0m\u001b[1;39m:\u001b[0m \u001b[0;39m1347.06\u001b[0m\u001b[1;39m,\u001b[0m\r\n  \u001b[1;34m\"prompt_tokens\"\u001b[0m\u001b[1;39m:\u001b[0m \u001b[0;39m8631\u001b[0m\u001b[1;39m,\u001b[0m\r\n  \u001b[1;34m\"completion_tokens\"\u001b[0m\u001b[1;39m:\u001b[0m \u001b[0;39m4655\u001b[0m\u001b[1;39m,\u001b[0m\r\n  \u001b[1;34m\"last_model\"\u001b[0m\u001b[1;39m:\u001b[0m \u001b[0;32m\"allam-2-7b\"\u001b[0m\r\n\u001b[1;39m}\u001b[0m\r\n"]
[21.537666, "o", "\u001b[H\u001b[2J\u001b[3J"]
[21.538129, "o", "\u001b[1;36mpromptpilot select-model   (interactive picker)\u001b[0m\r\n"]
[22.743253, "o", "\u001b[0;32m$\u001b[0m \u001b[1mpromptpilot --help\u001b[0m\r\n"]
[24.054019, "o", "\u001b[1m                                                                                                    \u001b[0m\r\n\u001b[1m \u001b[0m\u001b[1;33mUsage: \u001b[0m\u001b[1mpromptpilot [OPTIONS] COMMAND [ARGS]...\u001b[0m\u001b[1m                                                    \u001b[0m\u001b[1m \u001b[0m\r\n\u001b[1m                                                                                                    \u001b[0m\r\n"]
[24.060289, "o", " PromptPilot — Groq AI command-line workbench.                                                      \r\n                                                                                                    \r\n"]
[24.068417, "o", "\u001b[2m╭─\u001b[0m\u001b[2m Options \u001b[0m\u001b[2m───────────────────────────────────────────────────────────────────────────────────────\u001b[0m\u001b[2m─╮\u001b[0m\r\n\u001b[2m│\u001b[0m \u001b[1;36m-\u001b[0m\u001b[1;36m-json\u001b[0m                                  Emit one JSON document for automation.                   \u001b[2m│\u001b[0m\r\n\u001b[2m│\u001b[0m \u001b[1;36m-\u001b[0m\u001b[1;36m-color\u001b[0m                 \u001b[1;35m-\u001b[0m\u001b[1;35m-no\u001b[0m\u001b[1;35m-color\u001b[0m      Force colour on or off. By default the NO_COLOR          \u001b[2m│\u001b[0m\r\n\u001b[2m│\u001b[0m                                         environment variable is respected.                       \u001b[2m│\u001b[0m\r\n\u001b[2m│\u001b[0m \u001b[1;36m-\u001b[0m\u001b[1;36m-version\u001b[0m                               Show the installed version and exit.                     \u001b[2m│\u001b[0m\r\n\u001b[2m│\u001b[0m \u001b[1;36m-\u001b[0m\u001b[1;36m-install\u001b[0m\u001b[1;36m-completion\u001b[0m                    Install completion for the current shell.                \u001b[2m│\u001b[0m\r\n\u001b[2m│\u001b[0m \u001b[1;36m-\u001b[0m\u001b[1;36m-show\u001b[0m\u001b[1;36m-completion\u001b[0m                       Show completion for the current shell, to copy it or     \u001b[2m│\u001b[0m\r\n\u001b[2m│\u001b[0m                                         customize the installation.                              \u001b[2m│\u001b[0m\r\n\u001b[2m│\u001b[0m \u001b[1;36m-\u001b[0m\u001b[1;36m-help\u001b[0m                                  Show this message and exit.                              \u001b[2m│\u001b[0m\r\n\u001b[2m╰──────────────────────────────────────────────────────────────────────────────────────────────────╯\u001b[0m\r\n"]
[24.074301, "o", "\u001b[2m╭─\u001b[0m\u001b[2m Commands \u001b[0m\u001b[2m──────────────────────────────────────────────────────────────────────────────────────\u001b[0m\u001b[2m─╮\u001b[0m\r\n\u001b[2m│\u001b[0m \u001b[1;36mask         \u001b[0m\u001b[1;36m \u001b[0m Send one prompt and print the answer.                                              \u001b[2m│\u001b[0m\r\n\u001b[2m│\u001b[0m \u001b[1;36mchat        \u001b[0m\u001b[1;36m \u001b[0m Start an interactive chat session that remembers the conversation.                 \u001b[2m│\u001b[0m\r\n\u001b[2m│\u001b[0m \u001b[1;36mbatch       \u001b[0m\u001b[1;36m \u001b[0m Run multiple prompts concurrently with asyncio.gather.                             \u001b[2m│\u001b[0m\r\n\u001b[2m│\u001b[0m \u001b[1;36mmodels      \u001b[0m\u001b[1;36m \u001b[0m List the live model catalog returned by Groq.                                      \u001b[2m│\u001b[0m\r\n\u001b[2m│\u001b[0m \u001b[1;36mselect-model\u001b[0m\u001b[1;36m \u001b[0m Browse the live model catalog and save the one you choose.                         \u001b[2m│\u001b[0m\r\n\u001b[2m│\u001b[0m \u001b[1;36mdashboard   \u001b[0m\u001b[1;36m \u001b[0m Show local configuration and usage statistics.                                     \u001b[2m│\u001b[0m\r\n\u001b[2m│\u001b[0m \u001b[1;36mhistory     \u001b[0m\u001b[1;36m \u001b[0m Show the most recent prompts recorded on this machine.                             \u001b[2m│\u001b[0m\r\n\u001b[2m│\u001b[0m \u001b[1;36mbenchmark   \u001b[0m\u001b[1;36m \u001b[0m Compare end-to-end latency for one prompt across models.                           \u001b[2m│\u001b[0m\r\n\u001b[2m│\u001b[0m \u001b[1;36mprobe       \u001b[0m\u001b[1;36m \u001b[0m Demonstrate a thread pool with independent tiny API requests.                      \u001b[2m│\u001b[0m\r\n\u001b[2m│\u001b[0m \u001b[1;36mclear-stats \u001b[0m\u001b[1;36m \u001b[0m Delete the local statistics history.                                               \u001b[2m│\u001b[0m\r\n\u001b[2m│\u001b[0m \u001b[1;36mcompletions \u001b[0m\u001b[1;36m \u001b[0m Print the shell completion script for bash, zsh, or fish.                          \u001b[2m│\u001b[0m\r\n\u001b[2m│\u001b[0m \u001b[1;36mconfig      \u001b[0m\u001b[1;36m \u001b[0m Manage your local PromptPilot configuration.                                       \u001b[2m│\u001b[0m\r\n\u001b[2m╰──────────────────────────────────────────────────────────────────────────────────────────────────╯\u001b[0m\r\n"]
[24.07581, "o", "                                                                                                    \r\n \u001b[1mExamples\u001b[0m                                                                                           \r\n   promptpilot config set-key                 store your Groq API key                               \r\n   promptpilot ask \"Explain Python decorators\"                                                      \r\n   promptpilot ask \u001b[1;36m-\u001b[0m\u001b[1;36m-stream\u001b[0m \"Write a haiku\"  show tokens as they arrive                             \r\n   promptpilot chat                          start an interactive session                           \r\n   promptpilot \u001b[1;36m-\u001b[0m\u001b[1;36m-json\u001b[0m dashboard | jq .stats  machine-readable output                                \r\n                                                                                                    \r\n"]
[24.075858, "o", "\r\n"]
