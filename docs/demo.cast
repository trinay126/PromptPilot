[6.673835, "o", "\u001b[1;36m                   Available Groq models                   \u001b[0m\r\n\u001b[38;5;244m┏━━━┳━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┳━━━━━━━━━━━━━━━┓\u001b[0m\r\n\u001b[38;5;244m┃\u001b[0m\u001b[2;36m \u001b[0m\u001b[2;36m \u001b[0m\u001b[2;36m \u001b[0m\u001b[38;5;244m┃\u001b[0m\u001b[2;36m \u001b[0m\u001b[2;36mModel ID                           \u001b[0m\u001b[2;36m \u001b[0m\u001b[38;5;244m┃\u001b[0m\u001b[2;36m \u001b[0m\u001b[2;36mOwner        \u001b[0m\u001b[2;36m \u001b[0m\u001b[38;5;244m┃\u001b[0m\r\n\u001b[38;5;244m┡━━━╇━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━╇━━━━━━━━━━━━━━━┩\u001b[0m\r\n\u001b[38;5;244m│\u001b[0m \u001b[1;32m*\u001b[0m \u001b[38;5;244m│\u001b[0m\u001b[36m \u001b[0m\u001b[1;37mallam-2-7b\u001b[0m\u001b[36m                         \u001b[0m\u001b[36m \u001b[0m\u001b[38;5;244m│\u001b[0m\u001b[35m \u001b[0m\u001b[35mSDAIA        \u001b[0m\u001b[35m \u001b[0m\u001b[38;5;244m│\u001b[0m\r\n\u001b[38;5;244m│\u001b[0m   \u001b[38;5;244m│\u001b[0m\u001b[36m \u001b[0m\u001b[36mcanopylabs/orpheus-arabic-saudi    \u001b[0m\u001b[36m \u001b[0m\u001b[38;5;244m│\u001b[0m\u001b[35m \u001b[0m\u001b[35mCanopy Labs  \u001b[0m\u001b[35m \u001b[0m\u001b[38;5;244m│\u001b[0m\r\n\u001b[38;5;244m│\u001b[0m   \u001b[38;5;244m│\u001b[0m\u001b[36m \u001b[0m\u001b[36mcanopylabs/orpheus-v1-english      \u001b[0m\u001b[36m \u001b[0m\u001b[38;5;244m│\u001b[0m\u001b[35m \u001b[0m\u001b[35mCanopy Labs  \u001b[0m\u001b[35m \u001b[0m\u001b[38;5;244m│\u001b[0m\r\n\u001b[38;5;244m│\u001b[0m   \u001b[38;5;244m│\u001b[0m\u001b[36m \u001b[0m\u001b[36mmeta-llama/llama-prompt-guard-2-22m\u001b[0m\u001b[36m \u001b[0m\u001b[38;5;244m│\u001b[0m\u001b[35m \u001b[0m\u001b[35mMeta         \u001b[0m\u001b[35m \u001b[0m\u001b[38;5;244m│\u001b[0m\r\n\u001b[38;5;244m│\u001b[0m   \u001b[38;5;244m│\u001b[0m\u001b[36m \u001b[0m\u001b[36mmeta-llama/llama-prompt-guard-2-86m\u001b[0m\u001b[36m \u001b[0m\u001b[38;5;244m│\u001b[0m\u001b[35m \u001b[0m\u001b[35mMeta         \u001b[0m\u001b[35m \u001b[0m\u001b[38;5;244m│\u001b[0m\r\n\u001b[38;5;244m│\u001b[0m   \u001b[38;5;244m│\u001b[0m\u001b[36m \u001b[0m\u001b[36mopenai/gpt-oss-120b                \u001b[0m\u001b[36m \u001b[0m\u001b[38;5;244m│\u001b[0m\u001b[35m \u001b[0m\u001b[35mOpenAI       \u001b[0m\u001b[35m \u001b[0m\u001b[38;5;244m│\u001b[0m\r\n\u001b[38;5;244m│\u001b[0m   \u001b[38;5;244m│\u001b[0m\u001b[36m \u001b[0m\u001b[36mopenai/gpt-oss-20b                 \u001b[0m\u001b[36m \u001b[0m\u001b[38;5;244m│\u001b[0m\u001b[35m \u001b[0m\u001b[35mOpenAI       \u001b[0m\u001b[35m \u001b[0m\u001b[38;5;244m│\u001b[0m\r\n\u001b[38;5;244m│\u001b[0m   \u001b[38;5;244m│\u001b[0m\u001b[36m \u001b[0m\u001b[36mopenai/gpt-oss-safeguard-20b       \u001b[0m\u001b[36m \u001b[0m\u001b[38;5;244m│\u001b[0m\u001b[35m \u001b[0m\u001b[35mOpenAI       \u001b[0m\u001b[35m \u001b[0m\u001b[38;5;244m│\u001b[0m\r\n\u001b[38;5;244m│\u001b[0m   \u001b[38;5;244m│\u001b[0m\u001b[36m \u001b[0m\u001b[36mqwen/qwen3.8-27b                   \u001b[0m\u001b[36m \u001b[0m\u001b[38;5;244m│\u001b[0m\u001b[35m \u001b[0m\u001b[35mAlibaba Cloud\u001b[0m\u001b[35m \u001b[0m\u001b[38;5;244m│\u001b[0m\r\n\u001b[38;5;244m│\u001b[0m   \u001b[38;5;244m│\u001b[0m\u001b[36m \u001b[0m\u001b[36mwhisper-large-v3                   \u001b[0m\u001b[36m \u001b[0m\u001b[38;5;244m│\u001b[0m\u001b[35m \u001b[0m\u001b[35mOpenAI       \u001b[0m\u001b[35m \u001b[0m\u001b[38;5;244m│\u001b[0m\r\n\u001b[38;5;244m│\u001b[0m   \u001b[38;5;244m│\u001b[0m\u001b[36m \u001b[0m\u001b[36mwhisper-large-v3-turbo             \u001b[0m\u001b[36m \u001b[0m\u001b[38;5;244m│\u001b[0m\u001b[35m \u001b[0m\u001b[35mOpenAI       \u001b[0m\u001b[35m \u001b[0m\u001b[38;5;244m│\u001b[0m\r\n\u001b[38;5;244m└───┴─────────────────────────────────────┴───────────────┘\u001b[0m\r\n"]
